QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=documents

EMBEDDING_MODEL=BAAI/bge-m3
LLM_PROVIDER=vllm
LLM_MODEL=mistral:latest
REASON_MODEL=mistral:latest
OLLAMA_URL=http://host.docker.internal:11434/api/generate
VLLM_BASE_URL=http://vllm-service:8000/v1
VLLM_MODEL=llama3.2:3b-instruct
VLLM_HF_MODEL=AMead10/Llama-3.2-3B-Instruct-AWQ
VLLM_SERVED_MODEL_NAME=llama3.2:3b-instruct
VLLM_GPU_MEMORY_UTILIZATION=0.65
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=4
RAG_MAX_CONTEXT_CHARS=2500
RAG_FINAL_TOP_K=3
RAG_MAX_ANSWER_TOKENS=256

SECRET_KEY=replace-with-a-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
REQUEST_TIMEOUT=300
UI_USERS_JSON={}
UI_USERS_FILE=/app/data/users.json
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
UI_SESSION_TTL_SECONDS=604800
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_ui
POSTGRES_USER=rag_ui
POSTGRES_PASSWORD=change-me-postgres-password
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ASK_RATE_LIMIT_REQUESTS=60
ASK_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=300
