QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=documents

EMBEDDING_MODEL=BAAI/bge-m3
LLM_PROVIDER=vllm
LLM_MODEL=mistral:latest
REASON_MODEL=mistral:latest
OLLAMA_URL=http://host.docker.internal:11434/api/generate
VLLM_BASE_URL=http://vllm-service:8000/v1
VLLM_MODEL=llama3.2:3b-instruct
VLLM_HF_MODEL=AMead10/Llama-3.2-3B-Instruct-AWQ
VLLM_SERVED_MODEL_NAME=llama3.2:3b-instruct
VLLM_GPU_MEMORY_UTILIZATION=0.65
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=4
OCR_ENABLED=false
OCR_SERVICE_URL=http://ocr-service:8006/extract
OCR_MODEL_NAME=baidu/Unlimited-OCR
OCR_MAX_PAGES=20
OCR_RENDER_DPI=150
OCR_MAX_TOKENS=32768
OCR_REQUEST_TIMEOUT=1200
ASR_SERVICE_URL=http://asr-service:8007
ASR_MODEL=small
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
TTS_SERVICE_URL=http://tts-service:8008
COSYVOICE_REF=main
COSYVOICE_MODEL=iic/CosyVoice-300M-SFT
TTS_SAMPLE_RATE=22050
TTS_REQUEST_TIMEOUT=300
ZUP_SERVICE_URL=http://zup-service:8009
ZUP_API_BASE_URL=
ZUP_EMPLOYEES_PATH=/employees
ZUP_SEARCH_PARAM=q
ZUP_API_TOKEN=
ZUP_AUTH_HEADER=Authorization
ZUP_REQUEST_TIMEOUT=30
RAG_MAX_CONTEXT_CHARS=2500
RAG_FINAL_TOP_K=3
RAG_MAX_ANSWER_TOKENS=256

SECRET_KEY=replace-with-a-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
REQUEST_TIMEOUT=300
UI_USERS_JSON={}
UI_USERS_FILE=/app/data/users.json
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
UI_SESSION_TTL_SECONDS=604800
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_ui
POSTGRES_USER=rag_ui
POSTGRES_PASSWORD=change-me-postgres-password
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ASK_RATE_LIMIT_REQUESTS=60
ASK_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=300
