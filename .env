QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=documents

EMBEDDING_MODEL=BAAI/bge-m3
LLM_PROVIDER=vllm
LLM_MODEL=mistral:latest
REASON_MODEL=mistral:latest
OLLAMA_URL=http://host.docker.internal:11434/api/generate
VLLM_BASE_URL=http://vllm-service:8000/v1
VLLM_MODEL=rag-model
VLLM_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_SERVED_MODEL_NAME=rag-model
VLLM_GPU_MEMORY_UTILIZATION=0.65
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=4
RAG_MAX_CONTEXT_CHARS=2500
RAG_FINAL_TOP_K=3
RAG_MAX_ANSWER_TOKENS=256

SECRET_KEY=supersecretkey
REQUEST_TIMEOUT=300
UI_USERS_JSON={"admin":{"password":"admin123","role":"admin"},"user":{"password":"user123","role":"user"}}
UI_USERS_FILE=/app/data/users.json
